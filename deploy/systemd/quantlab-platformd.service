[Unit]
Description=QuantLab platformd
After=network-online.target quantlab-marketd.service quantlab-traderd.service quantlab-execd.service
Wants=network-online.target
PartOf=platform.target

[Service]
Type=simple
WorkingDirectory=/root/.config/superpowers/worktrees/quant-lab/autoresearch-20260328-all-plan
EnvironmentFile=-/etc/quantlab/platform.env
ExecStartPre=/usr/bin/mkdir -p /root/.config/superpowers/worktrees/quant-lab/autoresearch-20260328-all-plan/var/platform/logs
ExecStart=/usr/bin/bash -lc 'exec ./bin/platformd -config configs/live.yaml -execd-path ./bin/execd -listen 0.0.0.0:8080 >>var/platform/logs/platformd.log 2>&1'
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=platform.target
